# Copy to dev/.env (git ignores it). Used by `npm run dev:seed` and `npm run dev:run`.

# The dev server's password; `npm run dev:seed` sets it on a new server.
ACTUAL_PASSWORD=dev-password

# Printed by `npm run dev:seed`.
ACTUAL_BUDGET_SYNC_ID=
ACTUAL_SESSION_TOKEN=

# Where @actual-app/api keeps its copy of the budget (git ignores it).
ACTUAL_DATA_DIR=dev/.cache

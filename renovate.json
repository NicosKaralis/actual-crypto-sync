{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":pinAllExceptPeerDependencies",
    "docker:pinDigests",
    ":semanticCommits"
  ],
  "baseBranchPatterns": ["develop", "main"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Node: .nvmrc and the Dockerfile's base image move together",
      "matchDepNames": ["node"],
      "groupName": "Node.js"
    },
    {
      "description": "@actual-app/api and the actual-server image (dev stack, e2e) move together, with the Actual version in the README",
      "matchPackageNames": [
        "@actual-app/api",
        "actualbudget/actual-server",
        "docker.io/actualbudget/actual-server"
      ],
      "groupName": "Actual"
    },
    {
      "description": "main gets only the Actual updates; everything else goes to develop",
      "matchBaseBranches": ["main"],
      "enabled": false
    },
    {
      "description": "Each new Actual version goes straight to main as a fix, so Release Please releases it as a patch version. Renovate opens the PR once the version is 1 day old, and merges it when the checks pass",
      "matchBaseBranches": ["main"],
      "matchPackageNames": [
        "@actual-app/api",
        "actualbudget/actual-server",
        "docker.io/actualbudget/actual-server"
      ],
      "enabled": true,
      "automerge": true,
      "automergeStrategy": "merge-commit",
      "minimumReleaseAge": "1 day",
      "internalChecksFilter": "strict",
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "description": "develop gets the Actual updates from main, when the patch release merges back",
      "matchBaseBranches": ["develop"],
      "matchPackageNames": [
        "@actual-app/api",
        "actualbudget/actual-server",
        "docker.io/actualbudget/actual-server"
      ],
      "enabled": false
    },
    {
      "description": "OpenTelemetry packages require matching versions of each other (api, SDK, exporters, instrumentations), so they move together",
      "matchPackageNames": ["@opentelemetry/**"],
      "groupName": "OpenTelemetry"
    },
    {
      "description": "Biome's schema URL in biome.json follows the package",
      "matchPackageNames": ["@biomejs/biome"],
      "groupName": "Biome"
    },
    {
      "description": "runs-on and matrix runner labels move together",
      "matchDatasources": ["github-runners"],
      "groupName": "GitHub runners"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Runner labels in job matrices (runner: ubuntu-24.04, ubuntu-24.04-arm), which the github-actions manager only reads from runs-on",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["runner:\\s*(?<depName>ubuntu)-(?<currentValue>\\d+\\.\\d+)"],
      "datasourceTemplate": "github-runners"
    },
    {
      "customType": "regex",
      "description": "The Actual version in the README: the badge (URL and alt text) and the tested-with line",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": [
        "img\\.shields\\.io/badge/Actual-(?<currentValue>\\d+\\.\\d+\\.\\d+)-",
        "alt=\"Actual server (?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "tested with Actual server \\*\\*(?<currentValue>\\d+\\.\\d+\\.\\d+)\\*\\*"
      ],
      "depNameTemplate": "@actual-app/api",
      "datasourceTemplate": "npm"
    }
  ]
}

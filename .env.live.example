# Keys for the live checks (npm run test:live). Copy this file to .env.live,
# which git ignores, and fill in the keys you have. A check with a key is
# skipped when its key is empty; the checks without a key always run.
# Variables already set in the environment win over this file.
#
# The repository secrets have the same names: gh secret set -f .env.live

# TronGrid, from trongrid.io (optional key)
TRONGRID_API_KEY=
# An Ethereum JSON-RPC URL with its key in it, e.g. https://mainnet.infura.io/v3/<key>
ETHEREUM_RPC_URL=
# A BNB Smart Chain JSON-RPC URL with its key in it (optional)
BSC_RPC_URL=
# Blockscout, free from dev.blockscout.com (optional key)
BLOCKSCOUT_API_KEY=
# Etherscan, free from etherscan.io/apis (required by the etherscan explorer)
ETHERSCAN_API_KEY=
# Etherscan on a paid plan, for BNB Smart Chain: the free tier doesn't cover it
ETHERSCAN_BSC_API_KEY=
# A CoinGecko Demo key, free from coingecko.com/en/api (optional key)
COINGECKO_API_KEY=
# CoinPaprika, from coinpaprika.com/api (optional key; only a paid plan's key works)
COINPAPRIKA_API_KEY=
# CoinMarketCap, free from coinmarketcap.com/api (optional key; the free Basic plan works)
COINMARKETCAP_API_KEY=

{
  "name": "actual-crypto-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Keep Actual Budget off-budget accounts in line with your crypto wallets",
  "license": "MIT",
  "author": "Nicos Karalis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NicosKaralis/actual-crypto-sync.git"
  },
  "homepage": "https://github.com/NicosKaralis/actual-crypto-sync#readme",
  "bugs": "https://github.com/NicosKaralis/actual-crypto-sync/issues",
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc",
    "test": "tsc && node --test \"test/**/*.test.ts\"",
    "test:e2e": "docker compose -f test/e2e/compose.yml up --build --abort-on-container-exit --exit-code-from e2e; code=$?; docker compose -f test/e2e/compose.yml down -v; exit $code",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "dev:up": "docker compose -f dev/compose.yml up -d --wait",
    "dev:seed": "node --env-file=dev/.env dev/seed.ts",
    "dev:run": "node --env-file=dev/.env src/main.ts --config dev/config.yml",
    "dev:down": "docker compose -f dev/compose.yml down"
  },
  "dependencies": {
    "@actual-app/api": "26.11.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/instrumentation": "0.301.2",
    "@opentelemetry/instrumentation-undici": "0.35.1",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
